{
  "name": "nextjs-rstream-preview",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "build": "next build",
    "clean": "rm -rf .next .data .data-smoke tsconfig.tsbuildinfo",
    "dev:tunnel": "tsx src/server/rstream-next-server.ts",
    "dev": "next dev",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke:local": "node scripts/smoke-local.mjs",
    "start:tunnel": "NODE_ENV=production tsx src/server/rstream-next-server.ts",
    "start": "next start",
    "test": "npm run clean && npm run typecheck && npm run smoke:local",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@rstreamlabs/runtime": "^0.8.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "protobufjs": "8.7.1",
    "sharp": "0.35.3"
  }
}
