# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.27.0

ARG GST_VERSION=1.28.1

FROM --platform=$TARGETPLATFORM golang:${GO_VERSION}-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS base

ARG GST_VERSION

ARG TARGETARCH

WORKDIR /src

RUN apk add --no-cache \
	bash \
	bison \
	build-base \
	cmake \
	curl \
	flex \
	git \
	linux-headers \
	meson \
	nasm \
	ninja \
	nodejs \
	npm \
	perl \
	pkgconf \
	python3 \
	tar \
	xz \
	yasm

FROM base AS gstreamer

COPY producer/build-gstreamer-static-linux.sh ./

RUN ./build-gstreamer-static-linux.sh

FROM base AS web

COPY producer/package.json producer/package-lock.json producer/tsconfig.json producer/tailwind.config.js ./

COPY producer/internal/web/embed ./internal/web/embed

COPY shared ../shared

RUN --mount=type=cache,target=/root/.npm \
	npm ci && \
	npm run build

FROM base AS builder

ENV GOMODCACHE=/go/pkg/mod-linux

COPY --from=gstreamer /opt/gstreamer /opt/gstreamer

COPY producer/go.mod producer/go.sum ./

RUN --mount=type=cache,target=/go/pkg/mod-linux \
	go mod download

COPY producer/cmd ./cmd

COPY producer/internal ./internal

COPY producer/config.h264.yaml ./

COPY producer/build-static-linux.sh ./

COPY --from=web /src/internal/web/generated/app.js ./internal/web/generated/app.js

COPY --from=web /src/internal/web/generated/app.css ./internal/web/generated/app.css

RUN --mount=type=cache,target=/root/.cache/go-build \
	--mount=type=cache,target=/go/pkg/mod-linux \
	./build-static-linux.sh

FROM scratch AS export

COPY --from=builder /out/webrtc-video-producer /webrtc-video-producer

COPY --from=builder /src/config.h264.yaml /config.h264.yaml
