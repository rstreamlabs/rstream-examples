POSTGRES_PRISMA_POOL_URL="postgresql://postgres:postgres@localhost:5432/webrtc_video_platform?schema=public"
POSTGRES_PRISMA_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/webrtc_video_platform?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"
# user: private inventory per GitHub account (default).
# organization: shared inventory; active GitHub membership is rechecked within 60s.
DEVICE_ACCESS_MODE="user"
GITHUB_ORGANIZATION=""
# managed: provision devices through the application (default).
# discovered: organization only; list labeled tunnels from RSTREAM_PROJECT_ID.
DEVICE_INVENTORY_MODE="managed"
# In discovered mode, remember offline devices; false lists only live devices.
# PostgreSQL remains required for accounts/sessions in both cases.
DEVICE_DISCOVERY_HISTORY_ENABLED="true"
CRON_SECRET="replace-with-a-random-secret"
DEMO_CLEANUP_ENABLED="false"

RSTREAM_CLIENT_ID="rstream-app-client-id"
RSTREAM_CLIENT_SECRET="hex-encoded-rstream-app-client-secret"
RSTREAM_PROJECT_ENDPOINT="rstream-project-endpoint"
# Safety guard used only by the live edge-authentication qualification.
RSTREAM_EDGE_AUTH_EXPECTED_ENGINE="engine.example.com:443"
# Optional when RSTREAM_PROJECT_ENDPOINT is set.
RSTREAM_PROJECT_ID=""
# Optional public origin serving this realm's TURN server key. Set this when
# the control-plane origin is protected by an interactive access gateway.
RSTREAM_TURN_KEYRING_BASE_URL=""
RSTREAM_WEBHOOK_SIGNING_SECRET="whsec_..."

DEVICE_TOKEN_TTL_SECONDS="300"
TURN_CREDENTIAL_TTL_SECONDS="600"
VIEWER_TOKEN_TTL_SECONDS="120"
WATCH_TOKEN_TTL_SECONDS="120"

# Keep direct WebRTC as the default. Select mediamtx to route browser viewers
# through the on-demand distributor while the producer remains unchanged.
VIDEO_DISTRIBUTOR="direct"
# Set false for an enterprise installation that must retain one shared uplink.
MEDIAMTX_ALLOW_DIRECT_FALLBACK="true"
MEDIAMTX_EXPOSURE="rstream"
MEDIAMTX_PUBLIC_URL=""
# Optional, server-only endpoint on loopback or a private network. Never publish port 9998.
MEDIAMTX_METRICS_URL=""
MEDIAMTX_TUNNEL_NAME="webrtc-video-mediamtx"
MEDIAMTX_SOURCE_RESOLVER_JWKS='{"keys":[]}'
MEDIAMTX_SOURCE_RESOLVER_ISSUER="rstream-video-distributor"
MEDIAMTX_SOURCE_RESOLVER_AUDIENCE="rstream-video-source-resolver"
MEDIAMTX_JWT_PRIVATE_KEY_BASE64=""
MEDIAMTX_JWT_ADDITIONAL_JWKS='{"keys":[]}'
MEDIAMTX_JWT_ISSUER="rstream-webrtc-video-platform"
MEDIAMTX_JWT_AUDIENCE="rstream-mediamtx"
MEDIAMTX_TOKEN_TTL_SECONDS="300"
