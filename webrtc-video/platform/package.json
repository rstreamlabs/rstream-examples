{
  "name": "webrtc-video-platform",
  "private": true,
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "prisma@7.9.0": true
  },
  "scripts": {
    "build": "npm run prisma:generate && next build",
    "check-types": "npm run prisma:generate && tsc --noEmit",
    "clean": "rm -rf .next .prisma tsconfig.tsbuildinfo",
    "dev": "npm run prisma:generate && next dev",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "mediamtx:key": "node scripts/generate-mediamtx-key.mjs",
    "mediamtx:local": "./scripts/run-local-mediamtx.mjs",
    "qualify:distribution": "./qualification/end-to-end/run-matrix.sh",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "start": "next start",
    "test": "npm run test:unit && npm run typecheck",
    "test:mediamtx-auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/mediamtx-auth.integration.mjs",
    "test:rstream-edge-auth": "node --env-file-if-exists=.env.local scripts/rstream-edge-auth.integration.mjs",
    "test:rstream-edge-auth:context": "node scripts/rstream-edge-auth-context.integration.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/*.test.mjs",
    "typecheck": "npm run check-types",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@rstreamlabs/react": "^1.10.9",
    "@rstreamlabs/rstream": "^3.8.2",
    "@rstreamlabs/tunnels": "^3.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "deepmerge-ts": "8.0.1",
    "fast-uri": "4.1.2",
    "find-my-way": "9.7.0",
    "hono": "4.12.27",
    "postcss": "8.5.23",
    "protobufjs": "8.7.1",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "valibot": "1.4.2"
  }
}
